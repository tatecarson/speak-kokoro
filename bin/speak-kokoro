#!/bin/bash
# Speak text (stdin or $1) with Kokoro-82M. Talks to a resident daemon so the
# model stays loaded; starts the daemon on first use.
#
#   echo "hello" | speak-kokoro
#   speak-kokoro "hello"
#   VOICE=am_michael SPEED=1.15 speak-kokoro "hello"
#   speak-kokoro --stop        # stop playback
#   speak-kokoro --toggle      # pause or resume (replays the last text if idle)
#   speak-kokoro --next        # skip to the next sentence
#   speak-kokoro --prev        # back to the start of this or the previous sentence
#   speak-kokoro --quit        # shut the daemon down, freeing its memory
#   speak-kokoro --voices      # list available voices

PY="$HOME/.local/share/kokoro-venv/bin/python"
DAEMON="$HOME/.local/share/kokoro-venv/kokoro_daemon.py"
SOCK="/tmp/kokoro-tts.sock"
LOG="/tmp/kokoro-tts.log"
CONF="$HOME/.config/kokoro-tts.conf"
[ -f "$CONF" ] && . "$CONF"
VOICE="${VOICE:-af_heart}"
SPEED="${SPEED:-1.0}"
export PATH="/opt/homebrew/bin:$PATH"

# Send stdin to the daemon. Exits non-zero if nothing is listening, which is
# how a socket left behind by a killed daemon gets detected.
send() {
  "$PY" -c '
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(10)
try:
    s.connect(sys.argv[1])
except OSError:
    sys.exit(1)
s.sendall(sys.stdin.buffer.read())
s.shutdown(socket.SHUT_WR)
' "$SOCK" 2>/dev/null
}

case "$1" in
  --quit)
    pkill -f kokoro_daemon.py
    rm -f "$SOCK" /tmp/kokoro-speaking
    exit 0 ;;
  --stop)
    printf 'STOP' | send
    exit 0 ;;
  --toggle|--next|--prev)
    cmd="${1#--}"
    printf '%s' "$(echo "$cmd" | tr '[:lower:]' '[:upper:]')" | send
    exit 0 ;;
  --voices)
    "$PY" -c "
from huggingface_hub import list_repo_files
for f in sorted(list_repo_files('hexgrad/Kokoro-82M')):
    if f.startswith('voices/'): print(f.split('/')[-1][:-3])
" 2>/dev/null
    exit 0 ;;
esac

if [ -n "$1" ]; then TEXT="$1"; else TEXT=$(cat); fi
[ -z "${TEXT//[[:space:]]/}" ] && exit 0

speak() { printf 'SAY %s %s %s' "$VOICE" "$SPEED" "$TEXT" | send; }

# Fast path: a live daemon answers immediately.
if [ -S "$SOCK" ] && speak; then
  exit 0
fi

# Otherwise the socket is missing or stale (daemon killed without cleanup).
rm -f "$SOCK" /tmp/kokoro-speaking
VOICE="$VOICE" nohup "$PY" "$DAEMON" >>"$LOG" 2>&1 &
for _ in $(seq 1 120); do
  [ -S "$SOCK" ] && break
  sleep 0.5
done
speak
